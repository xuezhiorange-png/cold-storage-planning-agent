    "user_disclaimer_zh": "概念设计，需要复核，演示系数，不是施工图",
    "error_status": 400,
    "error_fields": ["ask_operator", "missing_keys"],
    "missing_parameter_code": "MISSING_ENGINEERING_PARAMETER",
    "unexpected_input_code": "MCP_INPUT_SCHEMA_REJECTED",
    "unavailable_code": "V20_FACTORY_POWER_CANONICAL_RESULT_UNAVAILABLE",
    "on_error": "ask_user_for_missing_keys_no_guessing",
    "authority_error_behavior": "preserve_backend_code_message_details_and_fail_closed",
    "existing_five_tool_behavior": "display markdown_table and extra_tables when present without rewriting numbers",
    "factory_power_behavior": "display markdown_table and preserve structured summary without recalculation"
  },
