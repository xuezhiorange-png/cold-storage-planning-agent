{
  "schema_id": "doubao_skill_pack",
  "schema_version": "1.2.0",
  "contract_family": "aily/v1.2",
  "title": "冷库规划助手 — 豆包工作伙伴 Skill（V1.2）",
  "language": "zh-CN",
  "paste_ready_markdown": "docs/contracts/aily/v1.2/doubao-skill.v1.md",
  "governance": {
    "AILY_OUTBOUND_LIVE_SESSION": "NO",
    "FORMULA_RECUT_AUTHORIZED": "NO",
    "ENVELOPE_FROM_ZONE_AREA": "NO",
    "DO_NOT_BUMP_ZONE_PLAN_VERSION": "YES",
    "KEEP_COOLING_LOAD_VERSION": "YES",
    "KEEP_EQUIPMENT_VERSION": "YES",
    "KEEP_INSTALLED_POWER_VERSION": "YES",
    "KEEP_INVESTMENT_VERSION": "YES",
    "AGENT_TO_ENGINEERING_VALUE": "NO",
    "MARK_REVIEWED_AS_MODEL_TOOL": "NO",
    "PRODUCTION_RBAC_CLAIM": "NO"
  },
  "calculator_identities": [
    {"name": "cold_room_zone_plan", "version": "1.0.0"},
    {"name": "cooling_load", "version": "1.0.0"},
    {"name": "equipment", "version": "1.0.0"},
    {"name": "installed_power", "version": "1.0.0"},
    {"name": "investment_estimate", "version": "1.0.0"}
  ],
  "operator_schema": {
    "schema_id": "OperatorProcessInputV1",
    "schema_version": "1.1.0"
  },
  "semantics": {
    "tonne_means": "per_day",
    "nlp_owner": "doubao",
    "system_parses_chat": false,
    "example_utterance_only": "要建一个多少吨的加工厂"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/v1/aily/v1/zone-plan",
      "role": "zone_plan_preview"
    },
    {
      "method": "POST",
      "path": "/api/v1/aily/v1/concept-preview",
      "role": "five_stage_preview"
    }
  ],
  "forbidden_paths": ["/api/v1/agent/**"],
  "mcp": {
    "transport": "streamable_http",
    "path": "/api/v1/aily/v1/mcp/sse",
    "tools_in_order": [
      "preview_zone_plan",
      "preview_cooling_load",
      "preview_equipment",
      "preview_installed_power",
      "preview_investment"
    ]
  },
  "cooling_honesty": {
    "demo_envelope": true,
    "envelope_from_zone_area": false,
    "user_disclaimer_zh": "冷量仍用演示围护，不是分区面积自动带入冷负荷"
  },
  "equipment_honesty": {
    "bind_cooling_subtotals_in_memory": true,
    "field_copy_only": true,
    "user_disclaimer_zh": "设备预览在内存拷贝冷负荷分区 subtotal_load_kw_r，不持久化"
  },
  "power_honesty": {
    "power_from_demo_catalog": true,
    "demo_catalog_source": "samples/v05-local-workbench/manifest.json",
    "user_disclaimer_zh": "装机功率压缩机电气输入用演示目录，不是设备结果自动换算；需复核"
  },
  "investment_honesty": {
    "investment_from_demo_catalog": true,
    "envelope_from_zone_area": false,
    "user_disclaimer_zh": "投资预览用演示目录面积/功率占位，不是分区规划面积自动带入"
  },
  "operator_keys": [
    {
      "field": "daily_inbound_mass_kg",
      "unit": "kg/day",
      "ask_operator_zh": "每天进货量（公斤/天；1吨/天=1000公斤/天）",
      "conversion": {
        "from": "吨/天",
        "multiply_by": 1000,
        "note": "豆包必须在调用前完成换算"
      }
    },
    {
      "field": "finished_storage_days",
      "unit": "day",
      "ask_operator_zh": "成品存放天数"
    },
    {
      "field": "frozen_storage_days",
      "unit": "day",
      "ask_operator_zh": "冻果存放天数"
    },
    {
      "field": "main_packaging_storage_days",
      "unit": "day",
      "ask_operator_zh": "主包材存放天数"
    },
    {
      "field": "auxiliary_packaging_storage_days",
      "unit": "day",
      "ask_operator_zh": "辅包材存放天数"
    }
  ],
  "response_handling": {
    "success_status": 200,
    "display_fields": ["markdown_table", "extra_tables"],
    "user_disclaimer_zh": "概念设计，需要复核，演示系数，不是施工图",
    "error_status": 400,
    "error_fields": ["ask_operator", "missing_keys"],
    "on_error": "ask_user_for_missing_keys_no_guessing"
  },
  "self_check": {
    "tools_list_must_include": [
      "preview_zone_plan",
      "preview_cooling_load",
      "preview_equipment",
      "preview_installed_power",
      "preview_investment"
    ],
    "tools_call_smoke": ["preview_cooling_load", "preview_investment"]
  },
  "forbidden_model_tools": [
    "mark_reviewed",
    "approve",
    "report.mark_reviewed",
    "report.approve"
  ],
  "forbidden_behaviors": [
    "compute_area_in_prompt",
    "compute_cooling_load_in_prompt",
    "send_chat_text_as_request_body",
    "invent_engineering_numbers",
    "feed_zone_area_into_cooling"
  ]
}
