# Local-only example. Canonical configuration keys use the COLD_STORAGE_ prefix.
COLD_STORAGE_ENVIRONMENT_ID=local
COLD_STORAGE_CONFIG_SCHEMA_VERSION=1
COLD_STORAGE_APP_DEBUG=false
COLD_STORAGE_APP_HOST=127.0.0.1
COLD_STORAGE_APP_PORT=8000
COLD_STORAGE_DATABASE_BACKEND=sqlite
COLD_STORAGE_SQLITE_PATH=./cold_storage_dev.db
COLD_STORAGE_STORAGE_DIR=./artifacts/local

# Optional local services; values are intentionally empty/example-only.
# COLD_STORAGE_REDIS_URL=redis://localhost:6379/0
# COLD_STORAGE_OPENAI_API_KEY=

# PostgreSQL discrete example (no password or production DSN).
# COLD_STORAGE_DATABASE_BACKEND=postgresql
# COLD_STORAGE_DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>
# COLD_STORAGE_POSTGRES_HOST=localhost
# COLD_STORAGE_POSTGRES_PORT=5432
# COLD_STORAGE_POSTGRES_DB=cold_storage
# COLD_STORAGE_POSTGRES_USER=cold_storage
# COLD_STORAGE_POSTGRES_PASSWORD=

# TASK-012 Slice 2: build / deployment identity and probe timeouts.
# These values are non-secret example keys used in local and test environments.
# Staging and production MUST provide explicit values; the in-image authority
# file `/opt/cold-storage/build-identity.json` is the single source of truth
# at runtime (see `docs/tasks/TASK-012-slice2-deployment-startup-lifecycle-contract.md`).
# COLD_STORAGE_BUILD_COMMIT_SHA=0000000000000000000000000000000000000000
# COLD_STORAGE_BUILD_VERSION=v0.0.0
# COLD_STORAGE_DEPLOYMENT_ID=local-deploy-example

# Probe timeouts. Staging and production require explicit integer values
# inside the documented bounds; local/test fall back to non-production defaults.
# COLD_STORAGE_STARTUP_PROBE_TIMEOUT_SECONDS=30
# COLD_STORAGE_READINESS_PROBE_TIMEOUT_SECONDS=5
